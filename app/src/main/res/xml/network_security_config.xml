<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- 放行明文 HTTP/WS：局域网远程 agent（pi-remote 等）通过用户显式配置的 ws://<局域网IP>
         与 http://<局域网IP>/upload 通信，系统策略不支持按 CIDR/IP 段白名单，逐主机维护也不现实，
         故整体放行明文。云端模型 API key 与对话内容仍优先走 TLS（provider 端点均为 https）。 -->
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
